                {links.map((link, idx) => {
                  const src = nodes.find(n => n.id === link.from);
                  const dst = nodes.find(n => n.id === link.to);
                  if (!src || !dst) return null;
                  return (
                    <g key={idx}>
                      <line
                        x1={src.x}
                        y1={src.y}
                        x2={dst.x}

                      style={{ left: `${node.x}px`, top: `${node.y}px`, transform: 'translate(-50%, -50%)' }}
                      className={`absolute px-3 py-2 rounded-xl border shadow-sm transition-all duration-150 flex items-center gap-2 cursor-pointer ${node.color} ${

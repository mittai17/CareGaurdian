{
  "name": "baseline",
  "private": true,
  "version": "0.1.0",
  "description": "AI-Powered Persistent Health Memory for Elderly Patients",
  "scripts": {
    "dev": "cd CareGaurdian-main/apps/web && pnpm dev",
    "start": "cd CareGaurdian-main/apps/web && pnpm dev",
    "build": "cd CareGaurdian-main && pnpm run build",
    "dev:api": "cd CareGaurdian-main/apps/api && pnpm start:dev",
    "dev:ml": "cd CareGaurdian-main/services/ml && python -m uvicorn app.main:app --reload --port 8001",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  }
}

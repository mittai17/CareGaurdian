// BASELINE — Prisma schema
// PostgreSQL + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  PATIENT
  GUARDIAN
  FAMILY_CAREGIVER
  PROFESSIONAL_CAREGIVER
  CLINICIAN
  PHARMACIST
  EMERGENCY_CLINICIAN
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  DOCUMENTED
  CLINICALLY_VERIFIED
  REPORTED
}

enum ConfidenceLevel {
  LOW
  MODERATE
  HIGH
  INSUFFICIENT_DATA
}

enum Severity {
  NORMAL
  ATTENTION
  REVIEW
  CRITICAL
  UNKNOWN
}

enum SignalType {
  CHANGE_SIGNAL
  MULTI_DOMAIN_CHANGE
  PERSONAL_PATTERN_MATCH
  FUNCTIONAL_DECLINE_SIGNAL
  MEDICATION_SIGNAL
  COGNITIVE_SIGNAL
}

enum EventType {
  MEDICATION_STARTED
  MEDICATION_STOPPED
  MEDICATION_CHANGED
  MISSED_MEDICATION
  FALL
  NEAR_FALL
  HOSPITALIZATION
  ER_VISIT
  SYMPTOM
  COGNITIVE_CHANGE
  FUNCTIONAL_CHANGE
  APPETITE_CHANGE
  SLEEP_CHANGE
  MOBILITY_CHANGE
  CAREGIVER_OBSERVATION
  LAB_RESULT
  PROCEDURE
  DIAGNOSIS
  ASSESSMENT
  MEDICATION_REMINDER
  CHECK_IN
  CONTACT
}

enum EventStatus {
  REPORTED
  VERIFIED
  CORRECTED
  REJECTED
}

enum SourceType {
  CAREGIVER
  PATIENT
  CLINICIAN
  PHARMACIST
  DOCUMENT
  FHIR
  ML
  SYSTEM
}

enum MemoryType {
  FACT
  OBSERVATION
  INFERENCE
}

enum ObservationCategory {
  CONFUSION
  FALL
  NEAR_FALL
  APPETITE
  SLEEP
  MOBILITY
  MOOD
  PAIN
  MEDICATION
  OTHER
}

enum BaselineMetricType {
  COGNITION
  MOBILITY
  WALKING
  SLEEP
  APPETITE
  MEDICATION_ADHERENCE
  MOOD
  PAIN
  DAILY_ACTIVITY
  ADLS
  IADLS
  WEIGHT
  BLOOD_PRESSURE
  GLUCOSE
}

model Organization {
  id          String     @id @default(uuid())
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  memberships OrganizationMembership[]
  patientRelationships PatientOrganizationRelationship[]
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
}

model PatientOrganizationRelationship {
  id             String       @id @default(uuid())
  patientId      String
  organizationId String
  relationship   String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([patientId, organizationId])
  @@index([organizationId])
}

model User {
  id            String                        @id @default(uuid())
  email         String                        @unique
  handle        String?                       @unique
  passwordHash  String
  name          String
  roles         UserRole[]
  mfaEnabled    Boolean                       @default(false)
  mfaSecret     String?
  organizationId String?
  memberships    OrganizationMembership[]
  organization  Organization?                 @relation(fields: [organizationId], references: [id])
  patients      PatientUserRelationship[]
  createdPatients Patient[]                    @relation("PatientCreatedBy")
  guardianRels  GuardianRelationship[]         @relation("GuardianUser")
  caregiverRels GuardianRelationship[]         @relation("CaregiverLinkedUser")
  observations  Observation[]
  consentsGranted Consent[]                    @relation("ConsentGrantor")
  consentsReceived Consent[]                   @relation("ConsentRecipient")
  auditEntries  AuditLog[]
  notifications Notification[]
  agentRuns     AgentRun[]                 @relation("AgentRunActor")
  documentsUploaded Document[]
  feedbacks     ClinicianFeedback[]
  sessions      Session[]
  sentMessages     Message[]                   @relation("SentMessages")
  receivedMessages Message[]                   @relation("ReceivedMessages")
  outgoingHandovers Handover[]                  @relation("OutgoingHandovers")
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([tokenHash])
}

model Patient {
  id                    String                              @id @default(uuid())
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String?
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  timezone              String                             @default("UTC")
  preferredLanguage      String                             @default("en")
  createdById           String?
  createdBy             User?                              @relation("PatientCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  users                 PatientUserRelationship[]
  organizations         PatientOrganizationRelationship[]
  conditions            Condition[]
  allergies             Allergy[]
  medications           Medication[]
  medicationEvents      MedicationEvent[]
  observations          Observation[]
  labResults            LabResult[]
  encounters            Encounter[]
  healthEvents          HealthEvent[]
  memoryFacts           HealthMemoryFact[]
  baselines             Baseline[]
  riskSignals           RiskSignal[]
  episodes              Episode[]
  documents             Document[]
  documentChunks        DocumentChunk[]
  consents              Consent[]
  guardianRels          GuardianRelationship[]
  auditEntries          AuditLog[]
  contradictions        Contradiction[]
  missingInfo           MissingInformation[]
  assessments           Assessment[]
  emergencyAccesses     EmergencyAccess[]
  agentRuns             AgentRun[]
  messages              Message[]
  handovers             Handover[]
  @@index([lastName, firstName])
  @@index([createdAt])
}

model PatientUserRelationship {
  id        String   @id @default(uuid())
  patientId String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([patientId, userId])
  @@index([userId])
}

model Message {
  id               String    @id @default(uuid())
  senderId         String
  receiverId       String?
  patientId        String?
  content          String
  status           String    @default("SENT")
  attachmentType   String?
  attachmentTitle  String?
  attachmentDetail String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sender           User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User?     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  patient          Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([patientId])
}

model GuardianRelationship {
  id            String   @id @default(uuid())
  patientId     String
  guardianUserId String
  linkedUserId  String?
  relationship  String
  startsAt      DateTime
  endsAt        DateTime?
  documentRef   String?
  status        String   @default("ACTIVE")
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  guardianUser  User     @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: Cascade)
  linkedUser    User?    @relation("CaregiverLinkedUser", fields: [linkedUserId], references: [id])
  @@index([patientId])
  @@index([guardianUserId])
}

model Condition {
  id                String             @id @default(uuid())
  patientId         String
  name              String
  code              String?
  codeSystem        String?
  diagnosedAt       DateTime?
  resolvedAt        DateTime?
  status            String             @default("ACTIVE")
  verificationStatus VerificationStatus @default(REPORTED)
  notes             String?
  sourceId          String?
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  @@index([patientId])
  @@index([name])
}

model Allergy {
  id                String             @id @default(uuid())
  patientId         String
  allergen          String
  reaction          String?
  severity          String?
  recordedAt        DateTime           @default(now())
  verificationStatus VerificationStatus @default(REPORTED)
  sourceId          String?
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  @@index([patientId])
  @@index([allergen])
}

model Medication {
  id          String    @id @default(uuid())
  patientId   String
  name        String
  genericName String?
  dosage      String?
  frequency   String?
  route       String?
  startedAt   DateTime?
  stoppedAt   DateTime?
  status      String    @default("ACTIVE")
  prescribedBy String?
  notes       String?
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      MedicationEvent[]
  @@index([patientId])
  @@index([status])
}

model MedicationEvent {
  id             String     @id @default(uuid())
  patientId      String
  medicationId   String?
  medicationName String
  type           String
  occurredAt     DateTime
  reason         String?
  sourceType     SourceType
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication     Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  @@index([patientId, occurredAt])
  @@index([medicationId])
}

model Observation {
  id                String             @id @default(uuid())
  patientId         String
  sourceUserId      String?
  sourceType        SourceType
  category          ObservationCategory
  rawText           String?
  structured        Json
  severity          String?
  duration          String?
  occurredAt        DateTime
  verificationStatus VerificationStatus @default(REPORTED)
  attachments       Json?
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  @@index([patientId, occurredAt])
  @@index([category])
  @@index([sourceUserId])
}

model LabResult {
  id             String   @id @default(uuid())
  patientId      String
  testName       String
  value          String
  unit           String?
  referenceRange String?
  collectedAt    DateTime
  interpretation String?
  sourceId       String?
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@index([patientId, collectedAt])
  @@index([testName])
}

model Encounter {
  id           String   @id @default(uuid())
  patientId    String
  providerName String?
  type         String
  reason       String?
  startedAt    DateTime
  endedAt      DateTime?
  location     String?
  notes        String?
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([patientId, startedAt])
}

model HealthEvent {
  id          String     @id @default(uuid())
  patientId   String
  type        EventType
  timestamp   DateTime
  sourceType  SourceType
  sourceId    String?
  status      EventStatus @default(REPORTED)
  confidence  Float      @default(0.8)
  description String?
  metadata    Json       @default("{}")
  episodeId   String?
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  episode     Episode?   @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  evidence    Evidence[]
  @@index([patientId, timestamp])
  @@index([type])
  @@index([episodeId])
}

model HealthMemoryFact {
  id         String     @id @default(uuid())
  patientId  String
  memoryType MemoryType @default(FACT)
  category   String
  content    String
  provenance Json
  sourceId   String?
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  @@index([patientId])
  @@index([category])
}

model Baseline {
  id           String            @id @default(uuid())
  patientId    String
  status       String            @default("INSUFFICIENT_DATA")
  computedAt   DateTime          @default(now())
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metrics      BaselineMetric[]
  @@unique([patientId])
  @@index([patientId])
}

model BaselineMetric {
  id             String             @id @default(uuid())
  baselineId     String
  metric         BaselineMetricType
  value          Float?
  unit           String?
  timeWindowDays Int
  sampleSize     Int
  confidence     ConfidenceLevel    @default(INSUFFICIENT_DATA)
  sourceCount    Int                @default(0)
  lastUpdated    DateTime           @default(now())
  stdDev         Float?
  baseline       Baseline           @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  @@unique([baselineId, metric])
}

model RiskSignal {
  id                 String         @id @default(uuid())
  patientId          String
  signalType         SignalType
  severity           Severity       @default(UNKNOWN)
  confidenceLevel    ConfidenceLevel @default(INSUFFICIENT_DATA)
  summary            String
  metrics            Json           @default("[]")
  evidenceIds        String[]       @default([])
  supportingSignals  Json           @default("[]")
  contradictions     Json           @default("[]")
  dataGaps           String[]       @default([])
  generatedAt        DateTime       @default(now())
  requiresHumanReview Boolean        @default(true)
  status             String         @default("PENDING")
  whyNow             Json?
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evidence           Evidence[]
  feedback           ClinicianFeedback[]
  @@index([patientId, generatedAt])
  @@index([status])
  @@index([severity])
}

model Episode {
  id                 String       @id @default(uuid())
  patientId          String
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  outcome            String?
  severity           Severity?
  symptoms           String[]     @default([])
  medicationsInvolved String[]     @default([])
  functionalChanges  String[]     @default([])
  cognitiveChanges   String[]     @default([])
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  events             HealthEvent[]
  createdAt          DateTime     @default(now())
  @@index([patientId])
  @@index([startDate])
}

model Assessment {
  id          String   @id @default(uuid())
  patientId   String
  type        String
  subtype     String?
  score       Float?
  result      String?
  notes       String?
  assessedAt  DateTime
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([patientId, assessedAt])
}

model Document {
  id          String   @id @default(uuid())
  patientId   String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  documentType String
  uploadedBy  String
  uploadedByUser User  @relation(fields: [uploadedBy], references: [id])
  parsedText  String?
  status      String   @default("UPLOADED")
  metadata    Json?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
  createdAt   DateTime @default(now())
  @@index([patientId])
  @@index([status])
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  patientId   String
  chunkIndex  Int
  text        String
  embedding   Unsupported("vector(384)")?
  metadata    Json     @default("{}")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([patientId])
  @@index([documentId])
}

model Consent {
  id             String   @id @default(uuid())
  patientId      String
  grantorId      String
  recipientId    String
  recipientType  UserRole
  dataScope      String[]
  purpose        String
  startDate      DateTime
  expirationDate DateTime?
  revokedAt      DateTime?
  status         String   @default("PENDING")
  grantor        User     @relation("ConsentGrantor", fields: [grantorId], references: [id])
  recipient      User     @relation("ConsentRecipient", fields: [recipientId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  permissions    Permission[]
  createdAt      DateTime @default(now())
  @@index([patientId])
  @@index([recipientId])
  @@index([status])
}

model Permission {
  id        String   @id @default(uuid())
  consentId String
  resource  String
  action    String
  allowed   Boolean  @default(true)
  consent   Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)
  @@index([consentId])
  @@unique([consentId, resource, action])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  patientId  String?
  action     String
  resourceType String
  resourceId String?
  timestamp  DateTime @default(now())
  purpose    String
  result     String
  metadata   Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  @@index([patientId, timestamp])
  @@index([actorId, timestamp])
  @@index([action])
}

model AgentRun {
  id          String   @id @default(uuid())
  patientId   String
  workflowId  String
  status      String   @default("PENDING")
  agentsRun   String[] @default([])
  result      Json?
  error       String?
  actorId     String?
  user        User?    @relation("AgentRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  @@index([patientId, startedAt])
}

model Evidence {
  id          String   @id @default(uuid())
  riskSignalId String
  eventId     String?
  claim       String
  detail      String?
  sourceType  SourceType
  sourceId    String?
  sourceDescription String?
  recordedAt  DateTime
  verified    Boolean  @default(false)
  riskSignal  RiskSignal @relation(fields: [riskSignalId], references: [id], onDelete: Cascade)
  event       HealthEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([riskSignalId])
}

model Contradiction {
  id          String           @id @default(uuid())
  patientId   String
  type        String
  description String
  evidenceA   String
  evidenceB   String
  detectedAt  DateTime         @default(now())
  status      String           @default("OPEN")
  confidence  ConfidenceLevel  @default(MODERATE)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, status])
}

model MissingInformation {
  id          String   @id @default(uuid())
  patientId   String
  category    String
  description String
  severity    Severity
  detectedAt  DateTime @default(now())
  status      String   @default("OPEN")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, status])
  @@index([category])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  patientId String?
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, read])
  @@index([createdAt])
}

model ClinicianFeedback {
  id          String   @id @default(uuid())
  signalId    String
  clinicianId String
  verdict     String
  comments    String?
  user        User     @relation(fields: [clinicianId], references: [id])
  riskSignal  RiskSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([signalId])
  @@index([clinicianId])
}

model EmergencyAccess {
  id          String   @id @default(uuid())
  patientId   String
  userId      String
  reason      String
  action      String
  expiresAt   DateTime
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([patientId])
  @@index([userId])
}

model Handover {
  id               String   @id @default(uuid())
  patientId        String
  outgoingStaffId  String
  incomingStaffName String?
  patientStatus    String
  tasksCompleted   String
  medicationsGiven String
  vitalSigns       String
  newSymptoms      String?
  observations     String?
  aiSummary        String
  signed           Boolean  @default(true)
  createdAt        DateTime @default(now())

  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  outgoingStaff    User     @relation("OutgoingHandovers", fields: [outgoingStaffId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([outgoingStaffId])
  @@index([createdAt])
}